{
    "name": "vitamin2/juicebox",
    "description": "This is the core Statamic addon used by VITAMIN 2.",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "VITAMIN 2",
            "homepage": "https://vitamin2.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vitamin2\\Juicebox\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vitamin2\\Juicebox\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "require": {
        "php": "^8.5",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "spatie/laravel-ray": "^1.43",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.1",
        "driftingly/rector-laravel": "^2.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "refactor": [
            "vendor/bin/rector process"
        ],
        "refactor:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/pest --parallel --coverage --min=100"
        ],
        "test:mutate": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/pest --mutate --parallel --min=100"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@refactor:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "statamic": {
            "name": "Juicebox 🧃",
            "description": "This is the core Statamic addon used by VITAMIN 2."
        },
        "laravel": {
            "providers": [
                "Vitamin2\\Juicebox\\ServiceProvider",
                "Vitamin2\\Juicebox\\Features\\SecureHeaders\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
