{
    "name": "vitamin2/juicebox",
    "description": "This is the core Statamic addon used by VITAMIN 2.",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "VITAMIN 2",
            "homepage": "https://vitamin2.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vitamin2\\Juicebox\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vitamin2\\Juicebox\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.5",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "spatie/laravel-ray": "^1.43",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "laravel/pao": "^1.1",
        "rector/rector": "^2.5",
        "driftingly/rector-laravel": "^2.5"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "refactor": [
            "vendor/bin/rector process"
        ],
        "refactor:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test": [
            "vendor/bin/phpunit"
        ],
        "check": [
            "@analyse",
            "@lint:check",
            "@refactor:check",
            "@test"
        ],
        "fix": [
            "@lint",
            "@refactor"
        ]
    },
    "extra": {
        "statamic": {
            "name": "Juicebox 🧃",
            "description": "This is the core Statamic addon used by VITAMIN 2."
        },
        "laravel": {
            "providers": [
                "Vitamin2\\Juicebox\\ServiceProvider",
                "Vitamin2\\Juicebox\\Features\\SecureHeaders\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
