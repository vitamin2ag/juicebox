{
    "name": "vitamin2/juicebox",
    "description": "This is the core Statamic addon used by VITAMIN 2.",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "VITAMIN 2",
            "homepage": "https://vitamin2.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vitamin2\\Juicebox\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vitamin2\\Juicebox\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.5",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "spatie/laravel-ray": "^1.43",
        "laravel/pint": "^1.29"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Juicebox 🧃",
            "description": "This is the core Statamic addon used by VITAMIN 2."
        },
        "laravel": {
            "providers": [
                "Vitamin2\\Juicebox\\ServiceProvider",
                "Vitamin2\\Juicebox\\Features\\SecureHeaders\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
